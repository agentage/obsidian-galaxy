{
  "name": "obsidian-galaxy",
  "version": "0.3.9",
  "description": "A 3D, rotating force-graph of your Obsidian vault. Part of Agentage Memory.",
  "private": true,
  "type": "module",
  "main": "main.js",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "node esbuild.config.mjs production",
    "build:preview": "node esbuild.config.mjs preview",
    "sample": "node scripts/build-sample.mjs",
    "install:vault": "npm run build && node scripts/install-to-vault.mjs",
    "type-check": "tsc --noEmit -skipLibCheck",
    "lint": "eslint src preview/harness.ts --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "clean": "rm -rf main.js *.map coverage preview/harness.js",
    "verify": "npm run type-check && npm run lint && npm run format:check && npm run test && npm run build"
  },
  "keywords": [
    "obsidian",
    "obsidian-plugin",
    "agentage",
    "memory",
    "graph",
    "3d"
  ],
  "author": "agentage",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "^26.6.5",
    "@types/three": "^0.186.0",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-obsidianmd": "0.4.2",
    "eslint-plugin-prettier": "5.5.7",
    "obsidian": "latest",
    "prettier": "3.9.10",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "8.72.1",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "3d-force-graph": "^1.80.1",
    "three": "^0.186.1",
    "three-spritetext": "1.10.0"
  }
}
